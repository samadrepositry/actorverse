# ACTORVERSE — environment variables (Phases 1–5)
# Copy this file to .env.local and fill in your own free Supabase project values.
# These are placeholders only — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# AI Coach (Phase 4) — optional, server-only. The owner creates a key at
# Google AI Studio (aistudio.google.com/app/apikey) and adds it here (and as
# a Vercel environment variable). WITHOUT it the Coach honestly says it is
# not connected yet. Never put this key in client code or in the repo.
GEMINI_API_KEY=your-gemini-api-key-here
